{
  "version": 1,
  "runs": {"pr": 3, "nightly": 5},
  "datasets": {
    "ilc-pdr": {"kind": "ilc", "drift": "pdr", "note": "公开商场数据，合成 PDR 漂移（尺度 σ4%、朝向 1.5°/√s）：模拟不开摄像头"},
    "ilc-arkit": {"kind": "ilc", "drift": "arkit", "note": "同上，合成视觉里程计漂移（尺度 σ1%、朝向 0.5°/√s）"},
    "ilc-pdr-sparse": {"kind": "ilc", "drift": "pdr", "build_max": 15, "note": "建图只用随机 15 条 trace：模拟「只走几趟」的稀疏建图"}
  },
  "scenarios": [
    {"id": "public/pdr/track-mag", "dataset": "ilc-pdr", "flags": ["--oracle-start", "--no-ble"],
     "title": "已知起点 · 只地磁 · 无摄像头", "tiers": ["pr", "nightly"], "gate": true},
    {"id": "public/pdr/cold-mag", "dataset": "ilc-pdr", "flags": ["--no-ble", "--cold-gate"],
     "title": "冷启动 · 只地磁 · 无摄像头", "tiers": ["pr", "nightly"], "gate": true, "target": {"wrong_fix": 0.2}},
    {"id": "public/pdr/cold-mag-radio", "dataset": "ilc-pdr", "flags": [],
     "title": "冷启动 · 地磁 + 蓝牙 · 无摄像头", "tiers": ["pr", "nightly"], "gate": true},
    {"id": "public/pdr-sparse/track-mag", "dataset": "ilc-pdr-sparse", "flags": ["--oracle-start", "--no-ble"],
     "title": "稀疏建图（走几趟）· 已知起点 · 只地磁", "tiers": ["pr", "nightly"], "gate": true},
    {"id": "public/pdr/track-mag-radio", "dataset": "ilc-pdr", "flags": ["--oracle-start"],
     "title": "已知起点 · 地磁 + 蓝牙 · 无摄像头", "tiers": ["nightly"], "gate": true},
    {"id": "public/vio/track-mag", "dataset": "ilc-arkit", "flags": ["--oracle-start", "--no-ble", "--odometry", "vio"],
     "title": "已知起点 · 只地磁 · 视觉里程计", "tiers": ["nightly"], "gate": true},
    {"id": "public/vio/cold-mag", "dataset": "ilc-arkit", "flags": ["--no-ble", "--odometry", "vio", "--cold-gate"],
     "title": "冷启动 · 只地磁 · 视觉里程计", "tiers": ["nightly"], "gate": true, "target": {"wrong_fix": 0.2}}
  ],
  "private": {
    "note": "自采数据（后台的建图 / 测试会话）。站点名只用哈希代号，公开仓库的报告里不出现任何站点信息",
    "protocols": {
      "walk-once": {"title": "走一遍建图 → 换一天测试（Oriient 的核心指标）", "flags": []},
      "all-builds": {"title": "全部建图会话融合 → 测试", "flags": []}
    },
    "tiers": ["pr", "nightly"],
    "gate": true
  },
  "tolerance": {
    "median_cm": {"better": "lower", "rel": 0.15, "abs": 30},
    "p90_cm": {"better": "lower", "rel": 0.15, "abs": 60},
    "wrong_fix": {"better": "lower", "rel": 0, "abs": 0.05},
    "coverage": {"better": "higher", "rel": 0, "abs": 0.07},
    "fixed_share": {"better": "higher", "rel": 0, "abs": 0.10}
  },
  "ladder": [
    {"name": "可用", "median_cm": 300, "p90_cm": 600, "wrong_fix": 0.20, "coverage": 0.5},
    {"name": "目标", "median_cm": 200, "p90_cm": 400, "wrong_fix": 0.10, "coverage": 0.6},
    {"name": "对标 Oriient", "median_cm": 150, "p90_cm": 300, "wrong_fix": 0.05, "coverage": 0.7}
  ]
}
